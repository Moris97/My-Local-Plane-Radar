{
  "version": 8,
  "name": "MLPR Online Dark",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#05070a" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#0c2740" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#12291b", "fill-opacity": 0.6 }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": { "fill-color": "#16231a", "fill-opacity": 0.5 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#14261a", "fill-opacity": 0.5 }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#2b2820", "fill-opacity": 0.75 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#193f5c",
        "line-width": ["match", ["get", "class"], "river", 1.2, 0.6]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "paint": {
        "line-color": "#0a1015",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 18, 1.8]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "paint": {
        "line-color": "#0c1418",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.4, 18, 2.8]
      }
    },
    {
      "id": "road-trunk-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["match", ["get", "class"], ["primary", "trunk"], true, false],
      "paint": {
        "line-color": "#101a20",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 18, 4]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#141f27",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 18, 4.5]
      }
    },
    {
      "id": "road-major-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": {
        "line-color": "#141c20",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "aeroway-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 10,
      "filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
      "paint": { "fill-color": "#143024", "fill-opacity": 0.6 }
    },
    {
      "id": "aeroway-taxiway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["==", ["get", "class"], "taxiway"]],
      "paint": {
        "line-color": "#1f4f36",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 20, 4]
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 9,
      "filter": ["all", ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false], ["==", ["get", "class"], "runway"]],
      "paint": {
        "line-color": "#3ddc84",
        "line-opacity": 0.85,
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 20, 14]
      }
    },
    {
      "id": "boundary-locality",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 9,
      "filter": ["all", [">=", ["get", "admin_level"], 7], ["<=", ["get", "admin_level"], 10], ["!=", ["get", "maritime"], 1]],
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": 0.5,
        "line-opacity": 0.6,
        "line-dasharray": [1, 2]
      }
    },
    {
      "id": "boundary-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": ["all", [">=", ["get", "admin_level"], 3], ["<=", ["get", "admin_level"], 6], ["!=", ["get", "maritime"], 1]],
      "paint": {
        "line-color": "#2c4759",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]],
      "paint": {
        "line-color": "#d4823f",
        "line-opacity": 0.6,
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.75, 12, 1.8]
      }
    },
    {
      "id": "airport-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "aerodrome_label",
      "minzoom": 8,
      "filter": ["has", "iata"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#3ddc84",
        "text-halo-color": "#05070a",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "label-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 14, 12]
      },
      "paint": {
        "text-color": "#5f7f92",
        "text-halo-color": "#05070a",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 12, 14]
      },
      "paint": {
        "text-color": "#8fb3c9",
        "text-halo-color": "#05070a",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 7, 13, 11, 18]
      },
      "paint": {
        "text-color": "#bcd7e8",
        "text-halo-color": "#05070a",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 8, 13],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#4d6a7d",
        "text-halo-color": "#05070a",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 9,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 4, 17]
      },
      "paint": {
        "text-color": "#d7ecf7",
        "text-halo-color": "#05070a",
        "text-halo-width": 1.2
      }
    }
  ]
}
